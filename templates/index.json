    "rich_text": {
      "type": "rich-text",
      "blocks": {
        "text": {
          "type": "text",
          "disabled": true,
          "settings": {
            "text": "<p><strong>✨Same sparkle, new hands at the ribbon ✨</strong><br/>EverWrap is now under new ownership, and we’re honored to carry on the tradition of beautiful, sustainable gifting.</p><p></p><p><strong>Hello and welcome to EverWrap!</strong><br/>We’re so glad you’re here. At EverWrap, we believe gifting should be beautiful, easy, and kind to the planet. That’s why we created reusable gift bags, boxes, and envelopes designed to last—so you can wrap once and gift forever. Whether you're new to reusable wrapping or adding to your collection, we’re here to help you celebrate sustainably.</p><p></p><p>- Jordan & Amy<br/></p>"
          }
        }
      },
