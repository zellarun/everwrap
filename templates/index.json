    "rich_text_4QpwEF": {
      "type": "rich-text",
      "blocks": {
        "heading_b4QDfE": {
          "type": "heading",
          "settings": {
            "heading": "The Wrap Revolution Starts with YOU",
            "heading_size": "h1"
          }
        },
        "text_BpCjhe": {
          "type": "text",
          "settings": {
            "text": "<p>You don't have to change everything to make a difference.</p><p><strong>Start with one EverWrap.</strong></p><p>Use it for a birthday.<br/>Pass it along at Christmas.<br/>Bring it to the next celebration.<br/>Use it again.</p><p>Every time you reuse it, you keep another piece of single-use gift wrap out of the trash.</p><p><strong>One wrap becomes a tradition.<br/>One small change becomes a movement.</strong></p><p>Join us in making gifting easier, more beautiful, and better for the planet.</p><h3><strong>Welcome to the Wrap Revolution.</strong></h3><p><strong>Wrap Once. Gift Forever.</strong></p>"
          }
        }
      },
