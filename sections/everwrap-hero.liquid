{%- style -%}
  #shopify-section-{{ section.id }} {
    --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

<section class="everwrap-hero color-{{ section.settings.color_scheme }} gradient" aria-labelledby="EverWrapHero-{{ section.id }}">
  <div class="everwrap-hero__media">
    {%- if section.settings.image != blank -%}
      {%- liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
        assign image_class = 'everwrap-hero__image'
        assign image_alt = section.settings.image.alt | default: section.settings.heading | strip_html
      -%}
      {{ section.settings.image
        | image_url: width: 2400
        | image_tag:
          width: section.settings.image.width,
          height: image_height,
          class: image_class,
          sizes: '100vw',
          widths: '640, 960, 1280, 1600, 2000, 2400',
          fetchpriority: 'high',
          alt: image_alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg everwrap-hero__image' }}
    {%- endif -%}
  </div>

  <div class="everwrap-hero__overlay"></div>

  <div class="everwrap-hero__content page-width">
    <div class="everwrap-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="everwrap-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h1 id="EverWrapHero-{{ section.id }}" class="everwrap-hero__heading">
        {{ section.settings.heading }}
      </h1>

      {%- if section.settings.text != blank -%}
        <div class="everwrap-hero__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="everwrap-hero__actions">
        {%- if section.settings.primary_label != blank -%}
          <a class="button button--primary" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
            {{ section.settings.primary_label | escape }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a class="button button--secondary" href="{{ section.settings.secondary_link | default: routes.root_url }}">
            {{ section.settings.secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="everwrap-benefits" aria-label="Why choose EverWrap">
    <div class="page-width everwrap-benefits__grid">
      {%- for block in section.blocks -%}
        <div class="everwrap-benefit" {{ block.shopify_attributes }}>
          <span class="everwrap-benefit__number" aria-hidden="true">0{{ forloop.index }}</span>
          <div>
            <p class="everwrap-benefit__title">{{ block.settings.heading | escape }}</p>
            <p class="everwrap-benefit__text">{{ block.settings.text | escape }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "EverWrap hero",
  "tag": "section",
  "class": "section section--everwrap-hero",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Image overlay",
      "default": 35
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Reusable gift wrap, reimagined"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Wrap once. <em>Gift forever.</em>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Beautiful, reusable gift wrap that makes every gift feel considered—without the tape, scissors, or waste.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop all wraps"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-5"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Effortless"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "No tape. No scissors. No mess."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EverWrap hero",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
