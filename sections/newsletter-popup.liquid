{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .newsletter-popup {
    position: fixed;
    inset: auto 1.6rem 1.6rem auto;
    z-index: 50;
    width: calc(100% - 3.2rem);
    max-width: 34rem;
    margin: 0;
    padding: 2.4rem 2rem 2rem;
    border: none;
    border-radius: var(--popup-corner-radius);
    box-shadow: 0 0.4rem 2.4rem rgba(0, 0, 0, 0.18);
    text-align: center;
  }

  .newsletter-popup[open] {
    animation: newsletter-popup-in 0.3s ease-out;
  }

  .newsletter-popup__heading {
    margin: 0 2.4rem 0.6rem;
  }

  .newsletter-popup__text {
    margin-bottom: 1.6rem;
    font-size: 1.4rem;
    line-height: 1.5;
  }

  .newsletter-popup__text p {
    margin: 0;
  }

  .newsletter-popup .newsletter-form {
    max-width: none;
  }

  .newsletter-popup__close {
    position: absolute;
    top: 0.4rem;
    right: 0.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.4rem;
    height: 4.4rem;
    padding: 0;
    border: none;
    background: transparent;
    color: rgb(var(--color-foreground));
    cursor: pointer;
  }

  .newsletter-popup__close .svg-wrapper {
    width: 1.4rem;
    height: 1.4rem;
  }

  @keyframes newsletter-popup-in {
    from {
      opacity: 0;
      transform: translateY(2rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .newsletter-popup[open] {
      animation: none;
    }
  }
{%- endstyle -%}

{%- if section.settings.enable -%}
  <newsletter-popup
    data-delay="{{ section.settings.delay }}"
    data-days="{{ section.settings.days_until_show_again }}"
    data-section-id="{{ section.id }}"
  >
    <dialog
      class="newsletter-popup color-{{ section.settings.color_scheme }} gradient"
      aria-labelledby="NewsletterPopupHeading-{{ section.id }}"
    >
      <button type="button" class="newsletter-popup__close" aria-label="{{ 'accessibility.close' | t }}" data-close>
        <span class="svg-wrapper">
          {{- 'icon-close.svg' | inline_asset_content -}}
        </span>
      </button>

      {%- if section.settings.heading != blank -%}
        <h2 id="NewsletterPopupHeading-{{ section.id }}" class="newsletter-popup__heading inline-richtext h3">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="newsletter-popup__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- form 'customer', id: 'NewsletterPopupForm', class: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <h3 class="newsletter-form__message newsletter-form__message--success form__message" tabindex="-1">
            <span class="svg-wrapper">
              {{- 'icon-success.svg' | inline_asset_content -}}
            </span>
            {%- if section.settings.success_message != blank -%}
              {{- section.settings.success_message | escape -}}
            {%- else -%}
              {{- 'newsletter.success' | t -}}
            {%- endif -%}
          </h3>
        {%- else -%}
          <div class="newsletter-form__field-wrapper">
            <div class="field">
              <input
                id="NewsletterPopupEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                class="field__input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="NewsletterPopupError-{{ section.id }}"
                {% endif %}
                placeholder="{{ 'newsletter.label' | t }}"
                required
              >
              <label class="field__label" for="NewsletterPopupEmail-{{ section.id }}">
                {{ 'newsletter.label' | t }}
              </label>
              <button
                type="submit"
                class="newsletter-form__button field__button"
                name="commit"
                aria-label="{{ 'newsletter.button_label' | t }}"
              >
                <span class="svg-wrapper">
                  {{- 'icon-arrow.svg' | inline_asset_content -}}
                </span>
              </button>
            </div>
            {%- if form.errors -%}
              <small class="newsletter-form__message form__message" id="NewsletterPopupError-{{ section.id }}">
                <span class="svg-wrapper">
                  {{- 'icon-error.svg' | inline_asset_content -}}
                </span>
                {{- form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email -}}
              </small>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endform -%}
    </dialog>
  </newsletter-popup>

  <script>
    if (!customElements.get('newsletter-popup')) {
      customElements.define(
        'newsletter-popup',
        class NewsletterPopup extends HTMLElement {
          static storageKey = 'everwrap-newsletter-popup';

          connectedCallback() {
            this.dialog = this.querySelector('dialog');
            this.querySelector('[data-close]').addEventListener('click', () => this.close());
            this.querySelector('form')?.addEventListener('submit', () => this.remember(3650));

            if (Shopify.designMode) {
              document.addEventListener('shopify:section:select', (event) => {
                if (event.detail.sectionId === this.dataset.sectionId) this.dialog.show();
              });
              document.addEventListener('shopify:section:deselect', (event) => {
                if (event.detail.sectionId === this.dataset.sectionId) this.dialog.close();
              });
              return;
            }

            // Reopen after the form posts back so the customer sees the success or error message.
            if (window.location.hash === '#NewsletterPopupForm') {
              this.dialog.show();
              return;
            }

            if (this.isDismissed()) return;
            this.timer = setTimeout(() => this.dialog.show(), Number(this.dataset.delay) * 1000);
          }

          disconnectedCallback() {
            clearTimeout(this.timer);
          }

          close() {
            this.remember();
            this.dialog.close();
          }

          remember(days = Number(this.dataset.days)) {
            try {
              localStorage.setItem(NewsletterPopup.storageKey, String(Date.now() + days * 86400000));
            } catch (e) {}
          }

          isDismissed() {
            try {
              return Number(localStorage.getItem(NewsletterPopup.storageKey)) > Date.now();
            } catch (e) {
              return false;
            }
          }
        }
      );
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Newsletter popup",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Show popup",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Seconds before popup appears",
      "default": 5
    },
    {
      "type": "range",
      "id": "days_until_show_again",
      "min": 1,
      "max": 60,
      "step": 1,
      "label": "Days before showing again after it's closed",
      "default": 7
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Wrap Revolution!"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Sign up for early access to new releases, exclusive offers, and gifting inspiration.</p>"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for joining! Watch your inbox."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Newsletter popup"
    }
  ]
}
{% endschema %}
